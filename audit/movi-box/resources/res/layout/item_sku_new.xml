<?xml version="1.0" encoding="utf-8"?>
<com.transsion.member.widget.StrokeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/sku_new_root"
    android:background="@drawable/bg_sku_item_selector"
    android:layout_width="@dimen/mini_dp_104"
    android:layout_height="@dimen/mini_dp_116"
    app:sll_cornerRadius="8dp"
    app:sll_strokeColor="@color/white_20"
    app:sll_strokeWidth="2dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/hot_container"
        android:background="@drawable/bg_sku_hot_icon"
        android:layout_width="41dp"
        android:layout_height="18dp">
        <ImageView
            android:id="@+id/iv_hot_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginVertical="2dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_hot_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOT"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/white_100"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:alpha="0.8"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="11sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_per_month_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:alpha="0.6"/>
</com.transsion.member.widget.StrokeLinearLayout>
