<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_zero_treasure"
        android:layout_width="match_parent"
        android:layout_height="73dp"
        android:scaleType="centerCrop"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/member_guide_banner_view_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp_6">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_member_guide_banner_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/mini_dp_58">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginStart="52dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/yellow_dark_10"
                    android:ellipsize="end"
                    android:id="@+id/tv_member_guide_title"
                    android:layout_width="194dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:fontFamily="@font/mulish_bold"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/yellow_dark_10"
                    android:ellipsize="end"
                    android:id="@+id/tv_member_guide_desc"
                    android:layout_width="194dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:fontFamily="@font/mulish_regular"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/yellow_dark_10"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_member_guide_btn"
                android:background="@drawable/bg_member_guide_banner_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:layout_weight="1"
                android:fontFamily="@font/mulish_bold"
                android:layout_marginEnd="@dimen/dp_12"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
